{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/session-start.mjs\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& node ((git rev-parse --show-toplevel) + '/.codex/hooks/session-start.mjs')\"",
            "timeout": 10,
            "statusMessage": "Loading session-analyzer guardrails"
          }
        ]
      }
    ]
  }
}
