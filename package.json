{
  "name": "session-analyzer",
  "version": "0.1.3",
  "description": "Local interactive viewer for Codex and Claude Code session transcripts.",
  "keywords": [
    "codex",
    "claude-code",
    "transcript",
    "viewer",
    "session",
    "local"
  ],
  "homepage": "https://github.com/Yijia-Zhou/session-analyzer#readme",
  "bugs": {
    "url": "https://github.com/Yijia-Zhou/session-analyzer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yijia-Zhou/session-analyzer.git"
  },
  "license": "BSD-3-Clause",
  "main": "server.js",
  "bin": {
    "session-analyzer": "server.js"
  },
  "files": [
    "server.js",
    "src/claude-detail.js",
    "src/claude-forks.js",
    "src/claude-logical.js",
    "src/claude-source.js",
    "src/claude.js",
    "src/codex-code-mode-declared.js",
    "src/codex-code-mode-facts.js",
    "src/codex-code-mode-presentation.js",
    "src/codex-code-mode.js",
    "src/codex-presentation-context.js",
    "src/review-lifecycle.js",
    "src/codex.js",
    "src/codex-detail.js",
    "src/codex-goal.js",
    "src/codex-logical.js",
    "src/codex-search.js",
    "src/codex-source.js",
    "src/codex-tool-lifecycle-contract.js",
    "src/folding.js",
    "src/source-adapters.js",
    "src/shared/",
    "public/",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node server.js",
    "build": "npm run build:client",
    "build:check": "node scripts/build-client.js --check",
    "build:client": "node scripts/build-client.js",
    "test": "node --test \"test/*.test.js\"",
    "test:browser": "node --test e2e/browser.test.js",
    "test:package": "node scripts/package-smoke.js",
    "release:check": "npm run build:check && npm test && npm run test:package",
    "release:preflight": "node scripts/release-automation.js preflight",
    "release:review-stage": "node scripts/release-automation.js review-stage",
    "release:verify-public": "node scripts/release-automation.js verify-public",
    "prepublishOnly": "npm run release:check",
    "profile:timeline": "node scripts/timeline-profile.js",
    "browser:install": "playwright install chromium",
    "vendor:highlight": "node scripts/build-client.js --vendor-highlight-only"
  },
  "dependencies": {
    "acorn": "8.15.0",
    "markdown-it": "14.3.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents": false
  },
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.22.2 || ^24.15.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.0.2",
      "onFail": "error"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "highlight.js": "11.11.1",
    "playwright": "^1.60.0"
  }
}
